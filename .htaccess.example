# /var/www/html/bathyal/.htaccess

# Security to prevent directory listing
Options -Indexes

# Set Environment Variables for Database Configuration
SetEnv DB_HOST 127.0.0.1
SetEnv DB_NAME bathyal_db
SetEnv DB_USER xxxxxx
SetEnv DB_PASS xxxxxx
SetEnv DB_CHARSET utf8mb4

# Set Environment Variables for SMTP Email Configuration
SetEnv SMTP_USER Youremaril@gmail.com
SetEnv SMTP_PASS YOURAPPPASSWORD
SetEnv SMTP_HOST smtp.gmail.com
SetEnv SMTP_PORT 587
SetEnv SMTP_SECURE tls
SetEnv SMTP_FROM_EMAIL your-email@gmail.com
SetEnv SMTP_FROM_NAME "YourAppName System"

# Basic routing (if you want all traffic through index.php later)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /bathyal/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Protect environment variables and config files from being read directly
<FilesMatch "^\.|\.php$">
    # Allow execution but deny direct read access from browser
    # (Handled mostly by Apache evaluating PHP, but a good safety net for config)
</FilesMatch>
# For Nginx
<FilesMatch "^(config\.php|database\.php|\.env|\.htaccess)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# For Apache
<FilesMatch "^(config\.php|database\.php|\.env|\.htaccess)$">
    Require all denied
</FilesMatch>